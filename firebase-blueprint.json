{
  "entities": {
    "WaitlistEntry": {
      "title": "WaitlistEntry",
      "description": "Waitlist entry data",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "format": "email"
        },
        "address": {
          "type": "string"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["email", "createdAt"]
    },
    "User": {
      "title": "User",
      "description": "User profile data",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "User ID"
        },
        "email": {
          "type": "string",
          "format": "email"
        },
        "displayName": {
          "type": "string"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email"]
    },
    "PortfolioBuilding": {
      "title": "PortfolioBuilding",
      "description": "A building saved to a user's portfolio",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "User ID of the owner"
        },
        "buildingId": {
          "type": "string",
          "description": "ID of the building from Chicago Data Portal"
        },
        "propertyName": {
          "type": "string"
        },
        "address": {
          "type": "string"
        },
        "propertyType": {
          "type": "string"
        },
        "sqFt": {
          "type": "number"
        },
        "yearBuilt": {
          "type": "number"
        },
        "energyStarScore": {
          "type": "number"
        },
        "ghgEmissions": {
          "type": "number"
        },
        "customName": {
          "type": "string",
          "description": "User's custom name for the building"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "buildingId", "address", "createdAt"]
    }
  },
  "firestore": {
    "/waitlist/{entryId}": {
      "schema": { "$ref": "#/entities/WaitlistEntry" },
      "description": "Waitlist entries"
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User profiles"
    },
    "/portfolioBuildings/{buildingId}": {
      "schema": { "$ref": "#/entities/PortfolioBuilding" },
      "description": "Buildings saved by users"
    }
  }
}
